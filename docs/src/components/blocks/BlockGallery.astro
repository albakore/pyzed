---
// The Blocks gallery: one large card per ready-made screen (thumbnail, name, one line).
// docs/scripts/gen_blocks.py writes the props into blocks/index.mdx.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/blocks/*.png', { eager: true });

interface Item {
	/** Page slug: `data-table`. */
	slug: string;
	/** Screenshot name: `data_table`. */
	shot: string;
	name: string;
	blurb: string;
}
interface Props {
	items: Item[];
	/** Link prefix: `/pyzed/blocks/` or `/pyzed/es/blocks/`. */
	base: string;
}

const { items, base } = Astro.props;
const pick = (shot: string, theme: string) => images[`../../assets/blocks/${shot}-${theme}.png`]?.default;
---

<div class="block-gallery not-content">
	{
		items.map((item) => {
			const dark = pick(item.shot, 'dark');
			const light = pick(item.shot, 'light') ?? dark;
			return (
				<a class="block-card" href={`${base}${item.slug}/`}>
					<div class="thumb">
						{dark && <Image class="on-dark" src={dark} alt="" width={720} loading="lazy" />}
						{light && <Image class="on-light" src={light} alt="" width={720} loading="lazy" />}
					</div>
					<div class="meta">
						<span class="name">{item.name}</span>
						<span class="blurb">{item.blurb}</span>
					</div>
				</a>
			);
		})
	}
</div>

<style>
	.block-gallery {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
		gap: 1.25rem;
		margin-block: 1.25rem 2rem;
	}
	.block-card {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.85rem;
		overflow: hidden;
		background: var(--sl-color-black);
		color: var(--sl-color-white);
		text-decoration: none;
		transition:
			border-color 0.15s,
			transform 0.15s,
			box-shadow 0.15s;
	}
	.block-card:hover {
		border-color: var(--sl-color-accent);
		transform: translateY(-2px);
		box-shadow: 0 12px 32px rgb(0 0 0 / 0.25);
	}
	.thumb {
		aspect-ratio: 1200 / 760;
		overflow: hidden;
		border-bottom: 1px solid var(--sl-color-gray-5);
		background: var(--sl-color-gray-6);
	}
	.thumb img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.meta {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 0.8rem 1rem 1rem;
	}
	.name {
		font-weight: 600;
	}
	.blurb {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		line-height: 1.45;
	}
	.on-light {
		display: none !important;
	}
	:global([data-theme='light']) .block-gallery .on-light {
		display: block !important;
	}
	:global([data-theme='light']) .block-gallery .on-dark {
		display: none !important;
	}
</style>
