---
// A grid of cards that link to pages: an icon, a title, a line of text and an optional tag.
// A card without `href` is shown as "coming soon" (dashed, not a link). Used by the section overviews
// and the home page.
//
//   <NavCards items={[{ title: 'Shader graphs', text: '...', href: '/pyzed/shading/shader-graphs/', icon: 'star' }]} />
import { Icon } from '@astrojs/starlight/components';

type IconName = Parameters<typeof Icon>[0]['name'];
interface Item {
	title: string;
	text: string;
	href?: string;
	icon?: IconName;
	/** A short label in the corner: "New", "Basic", "WGSL"... */
	tag?: string;
}
interface Props {
	items: Item[];
	/** Smallest card width; more columns fit on wide screens. */
	min?: string;
}
const { items, min = '15rem' } = Astro.props;
const soon = Astro.currentLocale === 'es' ? 'Próximamente' : 'Coming soon';
---

<div class="pz-nav-cards not-content" style={`--min: ${min}`}>
	{
		items.map((item) => {
			const Tag = item.href ? 'a' : 'div';
			return (
				<Tag class:list={['pz-nav-card', { soon: !item.href }]} href={item.href}>
					<span class="head">
						{item.icon && (
							<span class="icon">
								<Icon name={item.icon} size="1.15rem" />
							</span>
						)}
						{(item.tag || !item.href) && <span class="tag">{item.tag ?? soon}</span>}
					</span>
					<span class="title">
						{item.title}
						{item.href && (
							<span class="arrow" aria-hidden="true">
								→
							</span>
						)}
					</span>
					<span class="text" set:html={item.text} />
				</Tag>
			);
		})
	}
</div>

<style>
	.pz-nav-cards {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--min)), 1fr));
		gap: 0.9rem;
		margin-block: 1.5rem;
	}
	.pz-nav-card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding: 1.1rem 1.15rem 1.2rem;
		border-radius: 0.9rem;
		border: 1px solid var(--pz-frame-border);
		background: var(--pz-tile-bg);
		color: var(--sl-color-gray-2);
		text-decoration: none;
		transition:
			border-color 0.15s ease,
			transform 0.15s ease,
			box-shadow 0.15s ease;
	}
	a.pz-nav-card:hover,
	a.pz-nav-card:focus-visible {
		border-color: var(--pz-brand-line);
		transform: translateY(-2px);
	}
	.soon {
		border-style: dashed;
		background: transparent;
	}
	.head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		min-height: 2.25rem;
	}
	.icon {
		display: inline-grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 0.6rem;
		color: var(--pz-brand);
		background: var(--pz-brand-tint);
	}
	.soon .icon {
		color: var(--sl-color-gray-3);
		background: transparent;
		border-color: var(--sl-color-gray-5);
	}
	.tag {
		margin-inline-start: auto;
		padding: 0.1rem 0.55rem;
		border-radius: 999px;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		color: var(--sl-color-gray-2);
		border: 1px solid var(--sl-color-gray-5);
		white-space: nowrap;
	}
	.title {
		margin-top: 0.3rem;
		font-size: var(--sl-text-lg);
		font-weight: 600;
		line-height: 1.3;
		color: var(--sl-color-white);
	}
	.arrow {
		display: inline-block;
		margin-inline-start: 0.3rem;
		color: var(--pz-accent-text);
		transition: transform 0.15s ease;
	}
	a.pz-nav-card:hover .arrow {
		transform: translateX(3px);
	}
	.text {
		font-size: var(--sl-text-sm);
		line-height: 1.6;
	}
	.text :global(code) {
		font-family: var(--sl-font-mono);
		font-size: 0.9em;
		color: var(--sl-color-white);
	}
</style>
