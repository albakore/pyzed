---
// A framed screenshot or short screen recording, with an optional caption.
//
// Images come from src/assets so Astro serves them as responsive AVIF/WebP. Pass `light` to show a
// different capture in the light theme. A recording is a short muted loop (mp4, plus webm when there
// is one) that starts by itself, like a GIF but much lighter; with "reduce motion" it waits for a click.
//
//   import Media from '../../../components/Media.astro';
//   import dark from '../../../assets/editor/canvas-dark.png';
//   import light from '../../../assets/editor/canvas-light.png';
//   import clip from '../../../assets/editor/drag.mp4?url';
//   import poster from '../../../assets/editor/drag.png';
//
//   <Media src={dark} light={light} alt="The canvas with a form" caption="Drag a control from the toolbox." />
//   <Media video={clip} poster={poster} alt="Dragging a button onto the form" />
import type { ImageMetadata } from 'astro';
import { Picture, getImage } from 'astro:assets';

interface Props {
	/** The image (the dark-theme one when `light` is given). */
	src?: ImageMetadata;
	/** The same capture in the light theme. */
	light?: ImageMetadata;
	/** A recording: the URL of an .mp4 (import it with `?url`, or a path under public/). */
	video?: string;
	/** The same recording as .webm, offered first when given. */
	webm?: string;
	/** The image shown before a recording plays (and in light-theme prints). */
	poster?: ImageMetadata;
	alt: string;
	caption?: string;
	/** `wide` breaks out a little from the text column on large screens; `narrow` is for small dialogs. */
	size?: 'normal' | 'wide' | 'narrow';
	/** No frame or shadow, for captures that already have their own window shape. */
	plain?: boolean;
	/** Load right away instead of when it scrolls into view (for the first image of a page). */
	eager?: boolean;
	sizes?: string;
}

const {
	src,
	light,
	video,
	webm,
	poster,
	alt,
	caption,
	size = 'normal',
	plain = false,
	eager = false,
	sizes = '(min-width: 72rem) 48rem, 100vw',
} = Astro.props;

if (!src && !video) throw new Error('<Media> needs `src` or `video`.');

const widthsFor = (img: ImageMetadata) => {
	const widths = [480, 768, 1080, 1440, 2160].filter((w) => w < img.width);
	return [...widths, img.width];
};
const pictureAttrs = (img: ImageMetadata) => ({
	src: img,
	alt,
	sizes,
	widths: widthsFor(img),
	formats: ['avif', 'webp'] as const,
	fallbackFormat: 'png' as const,
	loading: eager ? ('eager' as const) : ('lazy' as const),
	decoding: 'async' as const,
});
const posterUrl = poster ? (await getImage({ src: poster, format: 'webp', width: Math.min(poster.width, 1440) })).src : undefined;
---

<figure class:list={['pz-media', `size-${size}`, { plain }]}>
	<div class="frame">
		{
			video ? (
				<video
					autoplay
					muted
					loop
					playsinline
					preload="metadata"
					poster={posterUrl}
					aria-label={alt}
					width={poster?.width}
					height={poster?.height}
				>
					{webm && <source src={webm} type="video/webm" />}
					<source src={video} type="video/mp4" />
				</video>
			) : (
				<>
					<Picture {...pictureAttrs(src!)} pictureAttributes={{ class: light ? 'pz-only-dark' : undefined }} />
					{light && <Picture {...pictureAttrs(light)} pictureAttributes={{ class: 'pz-only-light' }} />}
				</>
			)
		}
	</div>
	{caption && <figcaption set:html={caption} />}
</figure>

<script>
	// Respect "reduce motion": recordings stay paused, with controls, until the reader plays them.
	if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
		for (const video of document.querySelectorAll<HTMLVideoElement>('.pz-media video[autoplay]')) {
			video.removeAttribute('autoplay');
			video.pause();
			video.controls = true;
		}
	}
</script>

<style>
	.pz-media {
		margin-block: 1.5rem;
	}
	.frame {
		position: relative;
		border-radius: 0.8rem;
		overflow: hidden;
		border: 1px solid var(--pz-frame-border);
		box-shadow: var(--pz-frame-shadow);
		background: var(--sl-color-gray-6);
		line-height: 0;
	}
	.plain .frame {
		border: 0;
		box-shadow: none;
		background: transparent;
	}
	.frame :global(picture),
	.frame :global(img),
	video {
		display: block;
		width: 100%;
		height: auto;
		margin: 0;
		border: 0;
		border-radius: 0;
		box-shadow: none;
	}
	.size-narrow {
		max-width: 32rem;
		margin-inline: auto;
	}
	@media (min-width: 72rem) {
		.size-wide {
			margin-inline: -2rem;
		}
	}
	figcaption {
		margin-top: 0.7rem;
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--sl-color-gray-3);
		text-align: center;
	}
	figcaption :global(code) {
		font-size: 0.9em;
	}
</style>
