---
// A framed screenshot or short screen recording, with an optional caption.
//
// Images come from src/assets so Astro serves them as responsive AVIF/WebP. Pass `light` to show a
// different capture in the light theme. A recording is a short muted loop (mp4, plus webm when there
// is one) that plays by itself while it is on screen, like a GIF but much lighter; nothing of it but the poster
// loads until it scrolls into view, and with "reduce motion" it waits for a click.
//
// The clips made by docs/scripts/record.py live in public/media; name one with `clip` and its MP4, WebM,
// poster and size come from public/media/manifest.json:
//
//   <Media clip="snake" alt="The snake steering toward the food" caption="The game loop at work." />
//
// A clip recorded as an animated WebP only (record.py's `anim=True`, for short illustrations) is shown as an
// image (<AnimatedImage>): it loads lazily, is served as is from public/ (Astro's image pipeline would keep only
// its first frame) and, with "reduce motion", the still poster is shown instead.
//
//   import Media from '../../../components/Media.astro';
//   import dark from '../../../assets/editor/canvas-dark.png';
//   import light from '../../../assets/editor/canvas-light.png';
//   import clip from '../../../assets/editor/drag.mp4?url';
//   import poster from '../../../assets/editor/drag.png';
//
//   <Media src={dark} light={light} alt="The canvas with a form" caption="Drag a control from the toolbox." />
//   <Media video={clip} poster={poster} alt="Dragging a button onto the form" />
import type { ImageMetadata } from 'astro';
import { Picture, getImage } from 'astro:assets';
import AnimatedImage from './AnimatedImage.astro';
import manifest from '../../public/media/manifest.json';

interface Props {
	/** The image (the dark-theme one when `light` is given). */
	src?: ImageMetadata;
	/** The same capture in the light theme. */
	light?: ImageMetadata;
	/** A clip of public/media/manifest.json, by name: sets `video`, `webm` and the poster. */
	clip?: string;
	/** A recording: the URL of an .mp4 (import it with `?url`, or a path under public/). */
	video?: string;
	/** The same recording as .webm, offered first when given. */
	webm?: string;
	/** The image shown before a recording plays (and in light-theme prints). */
	poster?: ImageMetadata;
	alt: string;
	caption?: string;
	/** `wide` breaks out a little from the text column on large screens; `narrow` is for small dialogs;
	 * `small` is for a single node or a small widget. */
	size?: 'normal' | 'wide' | 'narrow' | 'small';
	/** No frame or shadow, for captures that already have their own window shape. */
	plain?: boolean;
	/** Load right away instead of when it scrolls into view (for the first image of a page). */
	eager?: boolean;
	sizes?: string;
}

const {
	src,
	light,
	clip,
	poster,
	alt,
	caption,
	size = 'normal',
	plain = false,
	eager = false,
	sizes = '(min-width: 72rem) 48rem, 100vw',
} = Astro.props;

let { video, webm } = Astro.props;
let posterUrl: string | undefined;
let videoWidth = poster?.width;
let videoHeight = poster?.height;
let animated: string | undefined;
if (clip) {
	const entry: { mp4?: string; webm?: string; webp?: string; poster: string; width: number; height: number } | undefined =
		manifest.clips.find((c) => c.name === clip);
	if (!entry) throw new Error(`<Media>: no clip named "${clip}" in public/media/manifest.json.`);
	const base = import.meta.env.BASE_URL.replace(/\/$/, '');
	if (entry.mp4) {
		video = `${base}/${entry.mp4}`;
		webm = entry.webm ? `${base}/${entry.webm}` : undefined;
	} else if (entry.webp) {
		animated = `${base}/${entry.webp}`;
	}
	posterUrl = `${base}/${entry.poster}`;
	videoWidth = entry.width;
	videoHeight = entry.height;
}
if (!src && !video && !animated) throw new Error('<Media> needs `src`, `video` or `clip`.');

const widthsFor = (img: ImageMetadata) => {
	const widths = [480, 768, 1080, 1440, 2160].filter((w) => w < img.width);
	return [...widths, img.width];
};
const pictureAttrs = (img: ImageMetadata) => ({
	src: img,
	alt,
	sizes,
	widths: widthsFor(img),
	formats: ['avif', 'webp'] as const,
	fallbackFormat: 'png' as const,
	loading: eager ? ('eager' as const) : ('lazy' as const),
	decoding: 'async' as const,
});
if (poster && !posterUrl) {
	posterUrl = (await getImage({ src: poster, format: 'webp', width: Math.min(poster.width, 1440) })).src;
}
---

<figure class:list={['pz-media', `size-${size}`, { plain }]}>
	<div class="frame">
		{
			animated ? (
				<AnimatedImage
					src={animated}
					poster={posterUrl!}
					alt={alt}
					width={videoWidth}
					height={videoHeight}
					eager={eager}
				/>
			) : video ? (
				<video
					data-pz-autoplay
					muted
					loop
					playsinline
					preload="none"
					poster={posterUrl}
					aria-label={alt}
					width={videoWidth}
					height={videoHeight}
				>
					{webm && <source src={webm} type="video/webm" />}
					<source src={video} type="video/mp4" />
				</video>
			) : (
				<>
					<Picture {...pictureAttrs(src!)} pictureAttributes={{ class: light ? 'pz-only-dark' : undefined }} />
					{light && <Picture {...pictureAttrs(light)} pictureAttributes={{ class: 'pz-only-light' }} />}
				</>
			)
		}
	</div>
	{caption && <figcaption set:html={caption} />}
</figure>

<script>
	// Recordings load and play only while they are on screen, and pause when they leave it. With "reduce
	// motion" they stay paused, with controls, until the reader plays them.
	const videos = document.querySelectorAll<HTMLVideoElement>('.pz-media video[data-pz-autoplay]');
	if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
		for (const video of videos) video.controls = true;
	} else {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const { target, isIntersecting } of entries) {
					const video = target as HTMLVideoElement;
					if (isIntersecting) video.play().catch(() => (video.controls = true));
					else video.pause();
				}
			},
			{ rootMargin: '200px 0px', threshold: 0.15 },
		);
		for (const video of videos) observer.observe(video);
	}
</script>

<style>
	.pz-media {
		margin-block: 1.5rem;
	}
	.frame {
		position: relative;
		border-radius: 0.8rem;
		overflow: hidden;
		border: 1px solid var(--pz-frame-border);
		box-shadow: var(--pz-frame-shadow);
		background: var(--sl-color-gray-6);
		line-height: 0;
	}
	.plain .frame {
		border: 0;
		box-shadow: none;
		background: transparent;
	}
	.frame :global(picture),
	.frame :global(img),
	video {
		display: block;
		width: 100%;
		height: auto;
		margin: 0;
		border: 0;
		border-radius: 0;
		box-shadow: none;
	}
	.size-narrow {
		max-width: 32rem;
		margin-inline: auto;
	}
	.size-small {
		max-width: 17rem;
		margin-inline: auto;
	}
	@media (min-width: 72rem) {
		.size-wide {
			margin-inline: -2rem;
		}
	}
	figcaption {
		margin-top: 0.7rem;
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--sl-color-gray-3);
		text-align: center;
	}
	figcaption :global(code) {
		font-size: 0.9em;
	}
</style>
