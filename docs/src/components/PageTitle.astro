---
// The page title. Pages with `section` in their frontmatter (the overview of a section) get a hero:
// an eyebrow with an icon, the title and a lead paragraph, over the dotted grid of the designer's canvas.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { Icon } from '@astrojs/starlight/components';

type IconName = Parameters<typeof Icon>[0]['name'];
const { title, description, section } = Astro.locals.starlightRoute.entry.data;
const lead = section?.lead ?? description;
---

{
	section ? (
		<header class="pz-page-hero">
			<p class="eyebrow">
				{section.icon && <Icon name={section.icon as IconName} size="1rem" />}
				{section.eyebrow}
			</p>
			<h1 id="_top">{title}</h1>
			{lead && <p class="lead">{lead}</p>}
		</header>
	) : (
		<Default />
	)
}

<style>
	.pz-page-hero {
		position: relative;
		isolation: isolate;
		margin-top: 0.5rem;
		padding: clamp(1.5rem, 1rem + 3vw, 2.75rem) clamp(1.25rem, 0.75rem + 2.5vw, 2.25rem);
		border-radius: 1.1rem;
		border: 1px solid var(--pz-border);
		background: var(--pz-surface);
		overflow: hidden;
	}
	.pz-page-hero::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background-color: var(--pz-canvas);
		background-image: radial-gradient(var(--pz-grid) 1px, transparent 1.3px);
		background-size: 16px 16px;
		mask-image: linear-gradient(100deg, transparent 35%, #000 85%);
	}
	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		margin: 0;
		padding: 0.25rem 0.7rem;
		border-radius: 999px;
		font: 500 0.75rem var(--sl-font-mono);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--pz-brand);
		background: var(--pz-brand-tint);
		border: 1px solid var(--pz-brand-line);
	}
	h1 {
		margin: 0.9rem 0 0;
		font-size: clamp(var(--sl-text-3xl), 1.4rem + 2.4vw, var(--sl-text-5xl));
		line-height: 1.08;
		font-weight: 700;
		letter-spacing: -0.03em;
		color: var(--sl-color-white);
	}
	.lead {
		max-width: 38rem;
		margin: 0.9rem 0 0;
		font-size: var(--sl-text-lg);
		line-height: 1.6;
		color: var(--pz-muted);
	}
</style>
