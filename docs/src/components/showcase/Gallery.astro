---
// A gallery of picture cards that link to demos: a capture, a title, a line of text and an optional tag.
// An item without `image` shows a placeholder tile (a capture is on the way). Used by the Showcase.
//
//   import Gallery from '../../../components/showcase/Gallery.astro';
//   import shot from '../../../assets/examples/todos.png';
//   <Gallery items={[{ title: 'Todos', text: 'Add, edit, filter and save tasks.', href: '/pyzed/showcase/apps/#todos', image: shot, tag: 'App' }]} />
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Item {
	title: string;
	text: string;
	href: string;
	image?: ImageMetadata;
	/** A short label over the picture: "Game", "GPU", "Designer"... */
	tag?: string;
}
interface Props {
	items: Item[];
	/** Smallest card width; more columns fit on wide screens. */
	min?: string;
}
const { items, min = '16rem' } = Astro.props;
const soon = Astro.currentLocale === 'es' ? 'Captura en camino' : 'Capture on the way';
---

<div class="pz-gallery not-content" style={`--min: ${min}`}>
	{
		items.map((item) => (
			<a class="card" href={item.href}>
				<span class="shot">
					{item.image ? (
						<Image src={item.image} alt={item.title} width={640} widths={[320, 640]} sizes={`(min-width: 50rem) 20rem, 100vw`} />
					) : (
						<span class="empty">{soon}</span>
					)}
					{item.tag && <span class="tag">{item.tag}</span>}
				</span>
				<span class="title">
					{item.title}
					<span class="arrow" aria-hidden="true">
						→
					</span>
				</span>
				<span class="text" set:html={item.text} />
			</a>
		))
	}
</div>

<style>
	.pz-gallery {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--min)), 1fr));
		gap: 1rem;
		margin-block: 1.25rem 2rem;
	}
	.card {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 0.6rem 0.6rem 1rem;
		border-radius: 0.9rem;
		border: 1px solid var(--pz-frame-border);
		background: var(--pz-tile-bg);
		color: var(--sl-color-gray-2);
		text-decoration: none;
		transition:
			border-color 0.15s ease,
			transform 0.15s ease,
			box-shadow 0.15s ease;
	}
	.card:hover,
	.card:focus-visible {
		border-color: color-mix(in srgb, var(--sl-color-accent) 70%, transparent);
		box-shadow: 0 10px 30px -14px color-mix(in srgb, var(--sl-color-accent) 70%, transparent);
		transform: translateY(-2px);
	}
	.shot {
		position: relative;
		display: block;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-radius: 0.55rem;
		background: var(--sl-color-gray-6);
		margin-bottom: 0.45rem;
	}
	.shot :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top left;
		transition: transform 0.3s ease;
	}
	.card:hover .shot :global(img) {
		transform: scale(1.03);
	}
	.empty {
		display: grid;
		place-items: center;
		height: 100%;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		border: 1px dashed var(--sl-color-gray-5);
		border-radius: 0.55rem;
	}
	.tag {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
		padding: 0.1rem 0.55rem;
		border-radius: 999px;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		color: #fff;
		background: rgb(0 0 0 / 0.55);
		backdrop-filter: blur(6px);
	}
	.title,
	.text {
		padding-inline: 0.45rem;
	}
	.title {
		font-size: var(--sl-text-base);
		font-weight: 650;
		line-height: 1.3;
		color: var(--sl-color-white);
	}
	.arrow {
		display: inline-block;
		margin-inline-start: 0.3rem;
		color: var(--pz-accent-text);
		transition: transform 0.15s ease;
	}
	.card:hover .arrow {
		transform: translateX(3px);
	}
	.text {
		font-size: var(--sl-text-sm);
		line-height: 1.55;
	}
	.text :global(code) {
		font-family: var(--sl-font-mono);
		font-size: 0.9em;
		color: var(--sl-color-white);
	}
</style>
