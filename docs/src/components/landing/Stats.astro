---
// A row of big numbers with a mono label and an amber LED, like the readouts of the audio rack.
// items: [{ value, label }]
interface Props {
	items: { value: string; label: string }[];
}
const { items } = Astro.props;
---

<dl class="pz-stats not-content">
	{
		items.map(({ value, label }) => (
			<div>
				<dt>
					<span class="pz-led" />
					{label}
				</dt>
				<dd>{value}</dd>
			</div>
		))
	}
</dl>

<style>
	.pz-stats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 10.5rem), 1fr));
		gap: 1px;
		margin-block: 2.5rem 0 !important;
		border-radius: 0.875rem;
		overflow: hidden;
		border: 1px solid var(--pz-border);
		background: var(--pz-border);
	}
	.pz-stats div {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding: 1.1rem 1.25rem;
		background: var(--pz-surface);
	}
	dt {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font: 500 0.6875rem var(--sl-font-mono);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--pz-muted);
	}
	dd {
		margin: 0;
		font-size: clamp(var(--sl-text-2xl), 1rem + 1.2vw, 1.875rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.1;
		color: var(--sl-color-white);
	}
</style>
