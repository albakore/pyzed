---
// A row of big numbers. items: [{ value, label }]
interface Props {
	items: { value: string; label: string }[];
}
const { items } = Astro.props;
---

<dl class="pz-stats not-content">
	{
		items.map(({ value, label }) => (
			<div>
				<dt>{label}</dt>
				<dd>{value}</dd>
			</div>
		))
	}
</dl>

<style>
	.pz-stats {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1px;
		margin-block: 3rem 0 !important;
		border-radius: 0.9rem;
		overflow: hidden;
		border: 1px solid var(--pz-frame-border);
		background: var(--pz-frame-border);
	}
	@media (min-width: 50rem) {
		.pz-stats {
			grid-template-columns: repeat(5, 1fr);
		}
	}
	.pz-stats div {
		display: flex;
		flex-direction: column-reverse;
		gap: 0.2rem;
		padding: 1.1rem 1rem;
		text-align: center;
		background: var(--sl-color-bg);
	}
	.pz-stats div:last-child:nth-child(odd) {
		grid-column: 1 / -1;
	}
	@media (min-width: 50rem) {
		.pz-stats div:last-child:nth-child(odd) {
			grid-column: auto;
		}
	}
	dd {
		margin: 0;
		font-size: clamp(var(--sl-text-2xl), 1rem + 2vw, var(--sl-text-4xl));
		font-weight: 700;
		line-height: 1.1;
		background: var(--pz-gradient);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
	dt {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
</style>
