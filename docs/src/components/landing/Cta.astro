---
// The closing call to action: a gradient panel with buttons (the slot can hold extra text).
import { LinkButton } from '@astrojs/starlight/components';

interface Props {
	title: string;
	primary: { text: string; href: string };
	secondary?: { text: string; href: string };
	command?: string;
}
const { title, primary, secondary, command } = Astro.props;
---

<section class="pz-cta not-content">
	<h2>{title}</h2>
	<div class="lead"><slot /></div>
	<div class="actions">
		<LinkButton href={primary.href} icon="download" iconPlacement="start">{primary.text}</LinkButton>
		{
			secondary && (
				<LinkButton href={secondary.href} variant="secondary" icon="right-arrow">
					{secondary.text}
				</LinkButton>
			)
		}
	</div>
	{command && <code class="command">{command}</code>}
</section>

<style>
	.pz-cta {
		position: relative;
		margin-block: 6rem 2rem !important;
		padding: clamp(2rem, 5vw, 3.5rem) clamp(1.25rem, 4vw, 3rem);
		border-radius: 1.25rem;
		text-align: center;
		overflow: hidden;
		border: 1px solid var(--pz-frame-border);
		background:
			radial-gradient(60% 120% at 15% 0%, color-mix(in srgb, #61afef 28%, transparent), transparent 70%),
			radial-gradient(60% 120% at 85% 100%, color-mix(in srgb, #c678dd 26%, transparent), transparent 70%),
			var(--pz-tile-bg);
	}
	h2 {
		margin: 0;
		font-size: clamp(var(--sl-text-2xl), 1rem + 2.4vw, var(--sl-text-5xl));
		line-height: 1.1;
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.lead {
		max-width: 36rem;
		margin: 1rem auto 0;
		font-size: var(--sl-text-lg);
		color: var(--sl-color-gray-2);
	}
	.lead :global(p) {
		margin: 0;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
		margin-top: 1.75rem;
	}
	.command {
		display: inline-block;
		margin-top: 1.5rem;
		padding: 0.45rem 0.9rem;
		border-radius: 0.5rem;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-white);
		background: color-mix(in srgb, var(--sl-color-black) 70%, transparent);
		border: 1px solid var(--pz-frame-border);
	}
</style>
