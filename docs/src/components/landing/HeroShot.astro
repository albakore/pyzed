---
// The big screenshot under the landing hero, with a deep shadow and floating LED chips (like the SNAP and
// GUIDES toggles of the designer).
import Shot from './Shot.astro';

interface Props {
	name: string;
	light?: string;
	alt: string;
	/** Short labels floating around the screenshot (hidden on small screens). */
	tags?: string[];
}

const { name, light, alt, tags = [] } = Astro.props;
---

<div class="pz-hero-shot not-content">
	<Shot name={name} light={light} alt={alt} eager sizes="(min-width: 72rem) 67rem, 100vw" />
	{
		tags.length > 0 && (
			<ul class="pz-hero-tags" aria-hidden="true">
				{tags.map((tag, i) => (
					<li class={`tag-${i}`}>
						<span class="pz-led" />
						{tag}
					</li>
				))}
			</ul>
		)
	}
</div>

<style>
	.pz-hero-shot {
		position: relative;
		margin-block: 0.5rem 0 !important;
	}
	.pz-hero-shot :global(.pz-shot) {
		border-radius: 0.875rem;
		box-shadow: var(--pz-shadow);
	}
	.pz-hero-tags {
		display: none;
	}
	@media (min-width: 64rem) {
		.pz-hero-tags {
			display: block;
			list-style: none;
			margin: 0;
			padding: 0;
		}
		.pz-hero-tags li {
			position: absolute;
			display: flex;
			align-items: center;
			gap: 0.5rem;
			padding: 0.35rem 0.75rem;
			border-radius: 0.4rem;
			font: 500 0.75rem var(--sl-font-mono);
			letter-spacing: 0.04em;
			text-transform: uppercase;
			color: var(--sl-color-white);
			background: var(--pz-panel);
			border: 1px solid var(--pz-border);
			box-shadow: 0 8px 24px rgb(0 0 0 / 0.25);
			animation: pz-float 6s ease-in-out infinite;
		}
		.tag-0 { top: 14%; left: -1rem; }
		.tag-1 { top: 42%; right: -1rem; animation-delay: -1.5s; }
		.tag-2 { bottom: 16%; left: 4%; animation-delay: -3s; }
		.tag-3 { bottom: 6%; right: 8%; animation-delay: -4.5s; }
	}
	@keyframes pz-float {
		50% { transform: translateY(-6px); }
	}
	@media (prefers-reduced-motion: reduce) {
		.pz-hero-tags li { animation: none; }
	}
</style>
