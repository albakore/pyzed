---
// Título del sitio con la última versión estable (sale de CHANGELOG.md, ver scripts/sync-changelog.mjs).
import Default from '@astrojs/starlight/components/SiteTitle.astro';
import release from '../generated/release.json';

const stable = release.latestStable?.version;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="site-title-with-version">
	<Default><slot /></Default>
	{stable && <a class="version-pill" href={`${base}/changelog/`} title="Última versión estable">v{stable}</a>}
</div>

<style>
	.site-title-with-version {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}
	.version-pill {
		font-size: var(--sl-text-xs);
		font-family: var(--sl-font-mono);
		padding: 0.1rem 0.5rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-5);
		color: var(--sl-color-gray-2);
		text-decoration: none;
		white-space: nowrap;
	}
	.version-pill:hover {
		color: var(--sl-color-accent-high);
		border-color: var(--sl-color-accent);
	}
</style>
