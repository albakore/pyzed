---
// The Pyzed wordmark (the python "p" + "yzed") plus the latest stable version (read from CHANGELOG.md,
// see scripts/sync-changelog.mjs).
import Wordmark from './brand/Wordmark.astro';
import release from '../generated/release.json';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const stable = release.latestStable?.version;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const es = Astro.currentLocale === 'es';
const changelog = `${base}${es ? '/es' : ''}/changelog/`;
---

<div class="site-title-with-version">
	<a href={siteTitleHref} class="site-title" aria-label={siteTitle}>
		<Wordmark />
	</a>
	{stable && <a class="version-pill" href={changelog} title={es ? 'Última versión estable' : 'Latest stable release'}>v{stable}</a>}
</div>

<style>
	.site-title-with-version {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.site-title {
		display: flex;
		align-items: center;
		font-size: 1.625rem;
		color: var(--sl-color-white);
		text-decoration: none;
		min-width: 0;
	}
	.version-pill {
		font-size: var(--sl-text-2xs);
		font-family: var(--sl-font-mono);
		font-weight: 500;
		padding: 0.1rem 0.55rem;
		border-radius: 999px;
		border: 1px solid var(--pz-brand-line);
		background: var(--pz-brand-tint);
		color: var(--pz-brand);
		text-decoration: none;
		white-space: nowrap;
	}
	.version-pill:hover {
		border-color: var(--pz-brand);
	}
</style>
