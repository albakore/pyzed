---
// Banner with the latest stable release, read from CHANGELOG.md (see scripts/sync-changelog.mjs).
import release from '../generated/release.json';

const stable = release.latestStable;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const es = Astro.currentLocale === 'es';
const changelog = `${base}${es ? '/es' : ''}/changelog/`;
---

{
	stable && (
		<a class="latest-release" href={changelog}>
			<span class="dot" />
			<span>
				{es ? 'Última versión estable' : 'Latest stable release'}: <strong>v{stable.version}</strong>
				{stable.date && <span class="date"> · {stable.date}</span>}
			</span>
			<span class="arrow">{es ? 'Ver novedades' : "What's new"} →</span>
		</a>
	)
}

<style>
	.latest-release {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		padding: 0.75rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
		text-decoration: none;
	}
	.latest-release:hover {
		border-color: var(--sl-color-accent);
	}
	.dot {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: var(--pz-led);
		box-shadow: var(--pz-led-glow);
	}
	.date {
		color: var(--sl-color-gray-3);
	}
	.arrow {
		margin-inline-start: auto;
		color: var(--sl-color-accent-high);
	}
</style>
