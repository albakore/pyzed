---
// Aviso con la última versión estable, leída de CHANGELOG.md (ver scripts/sync-changelog.mjs).
import release from '../generated/release.json';

const stable = release.latestStable;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{
	stable && (
		<a class="latest-release" href={`${base}/changelog/`}>
			<span class="dot" />
			<span>
				Última versión estable: <strong>v{stable.version}</strong>
				{stable.date && <span class="date"> · {stable.date}</span>}
			</span>
			<span class="arrow">Ver novedades →</span>
		</a>
	)
}

<style>
	.latest-release {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		padding: 0.75rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
		text-decoration: none;
	}
	.latest-release:hover {
		border-color: var(--sl-color-accent);
	}
	.dot {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: #a1c181;
	}
	.date {
		color: var(--sl-color-gray-3);
	}
	.arrow {
		margin-inline-start: auto;
		color: var(--sl-color-accent-high);
	}
</style>
