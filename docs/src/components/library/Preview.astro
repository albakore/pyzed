---
// A component preview of the library: an animated WebP recorded by docs/scripts/library_shots.py
// (public/library/), in One Dark or One Light to match the site's theme.
import Clip from './Clip.astro';

interface Props {
	/** File name without the theme suffix: `button` or `button-1`. */
	name: string;
	alt: string;
}

const { name, alt } = Astro.props;
---

<figure class="lib-preview not-content">
	<Clip name={name} alt={alt} />
</figure>

<style>
	.lib-preview {
		margin: 0;
		padding: 0;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		overflow: hidden;
		background: var(--sl-color-gray-6);
		box-shadow: 0 8px 28px rgb(0 0 0 / 0.18);
	}
	.lib-preview :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
