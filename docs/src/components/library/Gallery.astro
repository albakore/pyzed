---
// A grid of component cards (thumbnail, name, one line), like shadcn's component list.
// docs/scripts/gen_library.py writes the props into library/index.mdx.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/library/*.png', { eager: true });

interface Item {
	slug: string;
	name: string;
	blurb: string;
	badge?: string;
	/** "12 variants": how many captures the component's page shows. */
	count?: string;
}
interface Props {
	items: Item[];
	/** Link prefix: `/pyzed/library/` or `/pyzed/es/library/`. */
	base: string;
	/** A line above the cards: "8 components · 64 variants". */
	summary?: string;
}

const { items, base, summary } = Astro.props;
const pick = (slug: string, theme: string) =>
	(images[`../../assets/library/${slug}.thumb.${theme}.png`] ?? images[`../../assets/library/${slug}.${theme}.png`])?.default;
---

{summary && <p class="lib-summary not-content">{summary}</p>}
<div class="lib-gallery not-content">
	{
		items.map((item) => {
			const dark = pick(item.slug, 'dark');
			const light = pick(item.slug, 'light') ?? dark;
			return (
				<a class="lib-card" href={`${base}${item.slug}/`}>
					<div class="thumb">
						{dark && <Image class="on-dark" src={dark} alt="" width={480} loading="lazy" />}
						{light && <Image class="on-light" src={light} alt="" width={480} loading="lazy" />}
					</div>
					<div class="meta">
						<span class="name">
							{item.name}
							{item.badge && <span class="badge">{item.badge}</span>}
						</span>
						<span class="blurb">{item.blurb}</span>
						{item.count && <span class="count">{item.count}</span>}
					</div>
				</a>
			);
		})
	}
</div>

<style>
	.lib-summary {
		margin-block: 0.5rem 0;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		letter-spacing: 0.02em;
		color: var(--pz-accent-text, var(--sl-color-accent-high));
	}
	.lib-gallery {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 13.5rem), 1fr));
		gap: 1rem;
		margin-block: 0.75rem 2rem;
	}
	.lib-card {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--pz-frame-border, var(--sl-color-gray-5));
		border-radius: 0.75rem;
		overflow: hidden;
		background: var(--sl-color-black);
		color: var(--sl-color-white);
		text-decoration: none;
		transition:
			border-color 0.15s,
			transform 0.15s,
			box-shadow 0.15s;
	}
	.lib-card:hover {
		border-color: var(--sl-color-accent);
		transform: translateY(-2px);
		box-shadow: 0 10px 28px rgb(0 0 0 / 0.22);
	}
	.thumb {
		aspect-ratio: 2 / 1;
		overflow: hidden;
		border-bottom: 1px solid var(--sl-color-gray-5);
		background: var(--sl-color-gray-6);
	}
	.thumb img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.meta {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 0.7rem 0.85rem 0.85rem;
	}
	.name {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 600;
		font-size: var(--sl-text-sm);
	}
	.badge {
		font-size: 0.68rem;
		font-weight: 600;
		padding: 0.05rem 0.45rem;
		border-radius: 999px;
		color: var(--sl-color-accent-high);
		background: var(--sl-color-accent-low);
		border: 1px solid var(--sl-color-accent);
	}
	.blurb {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		line-height: 1.45;
	}
	.count {
		margin-top: auto;
		padding-top: 0.35rem;
		font-size: 0.7rem;
		font-weight: 600;
		color: var(--pz-accent-text, var(--sl-color-accent-high));
	}
	.on-light {
		display: none !important;
	}
	:global([data-theme='light']) .lib-gallery .on-light {
		display: block !important;
	}
	:global([data-theme='light']) .lib-gallery .on-dark {
		display: none !important;
	}
</style>
