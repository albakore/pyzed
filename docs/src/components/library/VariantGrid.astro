---
// A responsive grid of <Variant> captures (docs/scripts/gen_library.py writes them into each
// library page). Wide captures take a whole row; the rest share it.
---

<div class="lib-variants not-content">
	<slot />
</div>

<style>
	.lib-variants {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
		gap: 0.85rem;
		margin-block: 1rem 1.75rem;
	}
</style>
