# A calm notification style for the docs' screenshot (dunst on Linux), close to GNOME's.
[global]
font = "IBM Plex Sans 11"
width = 380
height = 140
origin = top-right
offset = 20x52
frame_width = 1
frame_color = "#2c2f3a"
corner_radius = 12
padding = 14
horizontal_padding = 16
text_icon_padding = 14
gap_size = 8
separator_height = 0
icon_position = left
min_icon_size = 40
max_icon_size = 40
show_indicators = no
markup = full
format = "<span size='small' foreground='#8d92a3'>%a</span>\n<b>%s</b>\n%b"

[urgency_low]
background = "#16181f"
foreground = "#e7e9ef"
timeout = 0

[urgency_normal]
background = "#16181f"
foreground = "#e7e9ef"
timeout = 0

[urgency_critical]
background = "#16181f"
foreground = "#e7e9ef"
frame_color = "#6d5df5"
timeout = 0
