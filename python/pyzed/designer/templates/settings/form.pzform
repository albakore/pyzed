    {
      "name": "label4",
      "type": "label",
      "x": 0,
      "y": 0,
      "width": 120,
      "height": 24,
      "props": {
        "text": "Volume",
        "size": "md",
        "color": "text",
        "weight": "normal",
        "align": "left",
        "wrap": true
      },
      "events": {},
      "anchor": [
        "left",
        "top"
      ],
      "visible": true,
      "enabled": true,
      "locked": false,
