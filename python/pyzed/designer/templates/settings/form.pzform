    },
    {
      "name": "buttons",
      "type": "row",
      "x": 24,
      "y": 220.0,
      "width": 432.0,
      "height": 36,
      "props": {
        "direction": "row",
        "gap": 8,
        "padding": 0,
        "justify": "end",
        "align": "stretch",
        "background": ""
      },
      "events": {},
      "anchor": [
        "left",
        "right",
        "bottom"
      ],
      "visible": true,
      "enabled": true,
      "locked": false
    },
    {
      "name": "save",
      "type": "button",
      "x": 0,
      "y": 0,
      "width": 96,
      "height": 32,
      "props": {
        "text": "Save",
        "variant": "solid",
