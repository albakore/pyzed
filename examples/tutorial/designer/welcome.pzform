{
  "format": "pyzed.form/1",
  "form": {
    "name": "welcome",
    "title": "Welcome",
    "width": 560,
    "height": 380,
    "theme": "Pyzed Dark",
    "accent": null,
    "background": null,
    "radius": null,
    "font_size": 14.0,
    "resizable": true,
    "grid": 8,
    "events": {
      "load": "form_load"
    },
    "code": null
  },
  "controls": [
    {
      "name": "backdrop",
      "type": "shader",
      "x": 0,
      "y": 0,
      "width": 560,
      "height": 380,
      "props": {
        "file": "",
        "variables": {
          "pulse": 2.0
        }
      },
      "events": {},
      "anchor": [
        "left",
        "top",
        "right",
        "bottom"
      ],
      "visible": true,
      "enabled": true,
      "locked": false
    },
    {
      "name": "card",
      "type": "card",
      "x": 140,
      "y": 100,
      "width": 280,
      "height": 180,
      "props": {
        "title": "",
        "shadow": true
      },
      "events": {},
      "anchor": [],
      "visible": true,
      "enabled": true,
      "locked": false,
      "style": {
        "background": "#0f172acc",
        "radius": 14
      }
    },
    {
      "name": "headline",
      "type": "heading",
      "x": 20,
      "y": 20,
      "width": 240,
      "height": 36,
      "props": {
        "text": "Welcome",
        "level": "2",
        "align": "center"
      },
      "events": {},
      "anchor": [
        "left",
        "top",
        "right"
      ],
      "visible": true,
      "enabled": true,
      "locked": false,
      "parent": "card"
    },
    {
      "name": "hint",
      "type": "label",
      "x": 20,
      "y": 64,
      "width": 240,
      "height": 40,
      "props": {
        "text": "The ring behind this card is a shader.",
        "size": "sm",
        "color": "text_muted",
        "align": "center"
      },
      "events": {},
      "anchor": [
        "left",
        "top",
        "right"
      ],
      "visible": true,
      "enabled": true,
      "locked": false,
      "parent": "card"
    },
    {
      "name": "faster",
      "type": "button",
      "x": 20,
      "y": 124,
      "width": 112,
      "height": 32,
      "props": {
        "text": "Faster",
        "icon": "zap"
      },
      "events": {
        "click": "faster_click"
      },
      "anchor": [
        "left",
        "top"
      ],
      "visible": true,
      "enabled": true,
      "locked": false,
      "parent": "card"
    },
    {
      "name": "color",
      "type": "button",
      "x": 148,
      "y": 124,
      "width": 112,
      "height": 32,
      "props": {
        "text": "Color",
        "icon": "palette"
      },
      "events": {
        "click": "color_click"
      },
      "anchor": [
        "left",
        "top"
      ],
      "visible": true,
      "enabled": true,
      "locked": false,
      "parent": "card"
    }
  ]
}
