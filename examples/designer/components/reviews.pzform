{
  "format": "pyzed.form/1",
  "form": {
    "name": "Reviews",
    "title": "Reviews",
    "width": 600,
    "height": 240,
    "theme": "One Dark",
    "accent": null,
    "background": null,
    "radius": null,
    "font_size": 14.0,
    "resizable": true,
    "grid": 8,
    "events": {},
    "code": null
  },
  "controls": [
    {
      "name": "cards",
      "type": "row",
      "x": 16,
      "y": 16,
      "width": 568,
      "height": 128,
      "props": {
        "direction": "row",
        "gap": 8,
        "padding": 0,
        "justify": "start",
        "align": "stretch",
        "background": ""
      },
      "events": {},
      "anchor": [
        "left",
        "top",
        "right"
      ],
      "visible": true,
      "enabled": true,
      "locked": false
    },
    {
      "name": "ada",
      "type": "profile_card",
      "x": 0,
      "y": 0,
      "width": 280,
      "height": 128,
      "props": {
        "person": "Ada Lovelace",
        "job": "Mathematician",
        "score": 4
      },
      "events": {
        "rated": "ada_rated"
      },
      "anchor": [
        "left",
        "top"
      ],
      "visible": true,
      "enabled": true,
      "locked": false,
      "parent": "cards",
      "layout": {
        "grow": 1
      }
    },
    {
      "name": "grace",
      "type": "profile_card",
      "x": 288,
      "y": 0,
      "width": 280,
      "height": 128,
      "props": {
        "person": "Grace Hopper",
        "job": "Computer scientist",
        "score": 5
      },
      "events": {
        "rated": "grace_rated"
      },
      "anchor": [
        "left",
        "top"
      ],
      "visible": true,
      "enabled": true,
      "locked": false,
      "parent": "cards",
      "layout": {
        "grow": 1
      }
    },
    {
      "name": "status",
      "type": "label",
      "x": 16,
      "y": 168,
      "width": 568,
      "height": 24,
      "props": {
        "text": "Rate someone.",
        "size": "md",
        "color": "text",
        "weight": "normal",
        "align": "left",
        "wrap": true
      },
      "events": {},
      "anchor": [
        "left",
        "top",
        "right"
      ],
      "visible": true,
      "enabled": true,
      "locked": false
    }
  ]
}
