{
  "format": "pyzed.form/1",
  "form": {
    "name": "tasks",
    "title": "Task runner",
    "width": 560,
    "height": 440,
    "theme": "One Dark",
    "accent": "#74ade8",
    "background": null,
    "radius": 8,
    "font_size": 14.0,
    "resizable": true,
    "grid": 8,
    "events": {
      "load": "form_load"
    },
    "code": null
  },
  "controls": [
    {
      "name": "header",
      "type": "heading",
      "x": 24,
      "y": 20,
      "width": 300,
      "height": 32,
      "props": {
        "text": "Task runner",
        "level": "2",
        "align": "left"
      },
      "events": {},
      "anchor": [
        "left",
        "top"
      ],
      "visible": true,
      "enabled": true,
      "locked": false
    },
    {
      "name": "clock",
      "type": "label",
      "x": 400,
      "y": 26,
      "width": 136,
      "height": 24,
      "props": {
        "text": "00:00:00",
        "size": "md",
        "color": "text_muted",
        "weight": "normal",
        "align": "right",
        "wrap": true
      },
      "events": {},
      "anchor": [
        "top",
        "right"
      ],
      "visible": true,
      "enabled": true,
      "locked": false
    },
    {
      "name": "command",
      "type": "input",
      "x": 24,
      "y": 68,
      "width": 400,
      "height": 32,
      "props": {
        "text": "python -c \"import this\"",
        "placeholder": "A command to run",
        "icon": "",
        "secure": false
      },
      "events": {
        "submit": "command_submit"
      },
      "anchor": [
        "left",
        "top",
        "right"
      ],
      "visible": true,
      "enabled": true,
      "locked": false
    },
    {
      "name": "run",
      "type": "button",
      "x": 436,
      "y": 68,
      "width": 100,
      "height": 32,
      "props": {
        "text": "Run",
        "variant": "filled",
        "icon": ""
      },
      "events": {
        "click": "run_click"
      },
      "anchor": [
        "top",
        "right"
      ],
      "visible": true,
      "enabled": true,
      "locked": false
    },
    {
      "name": "output",
      "type": "text_area",
      "x": 24,
      "y": 112,
      "width": 512,
      "height": 200,
      "props": {
        "text": "",
        "placeholder": "Write something…",
        "language": "txt",
        "line_numbers": false,
        "wrap": true
      },
      "events": {},
      "anchor": [
        "left",
        "top",
        "right",
        "bottom"
      ],
      "visible": true,
      "enabled": true,
      "locked": false
    },
    {
      "name": "count",
      "type": "button",
      "x": 24,
      "y": 328,
      "width": 140,
      "height": 32,
      "props": {
        "text": "Count primes",
        "variant": "filled",
        "icon": ""
      },
      "events": {
        "click": "count_click"
      },
      "anchor": [
        "left",
        "bottom"
      ],
      "visible": true,
      "enabled": true,
      "locked": false
    },
    {
      "name": "progress",
      "type": "progress",
      "x": 180,
      "y": 340,
      "width": 356,
      "height": 8,
      "props": {
        "value": 0,
        "max": 100,
        "tint": "accent"
      },
      "events": {},
      "anchor": [
        "left",
        "right",
        "bottom"
      ],
      "visible": true,
      "enabled": true,
      "locked": false
    },
    {
      "name": "status",
      "type": "label",
      "x": 24,
      "y": 380,
      "width": 512,
      "height": 24,
      "props": {
        "text": "",
        "size": "sm",
        "color": "text_muted",
        "weight": "normal",
        "align": "left",
        "wrap": true
      },
      "events": {},
      "anchor": [
        "left",
        "right",
        "bottom"
      ],
      "visible": true,
      "enabled": true,
      "locked": false
    },
    {
      "name": "ticker",
      "type": "timer",
      "x": 0,
      "y": 0,
      "width": 120,
      "height": 24,
      "props": {
        "interval": 1000,
        "running": true,
        "repeat": true
      },
      "events": {
        "tick": "ticker_tick"
      },
      "anchor": [
        "left",
        "top"
      ],
      "visible": true,
      "enabled": true,
      "locked": false
    },
    {
      "name": "run_key",
      "type": "shortcut",
      "x": 0,
      "y": 0,
      "width": 120,
      "height": 24,
      "props": {
        "keys": "mod-r"
      },
      "events": {
        "activate": "run_key_activate"
      },
      "anchor": [
        "left",
        "top"
      ],
      "visible": true,
      "enabled": true,
      "locked": false
    },
    {
      "name": "proc",
      "type": "process",
      "x": 0,
      "y": 0,
      "width": 120,
      "height": 24,
      "props": {
        "command": "",
        "directory": "",
        "shell": false,
        "autostart": false
      },
      "events": {
        "output": "proc_output",
        "error_output": "proc_output",
        "finished": "proc_finished",
        "failed": "proc_failed"
      },
      "anchor": [
        "left",
        "top"
      ],
      "visible": true,
      "enabled": true,
      "locked": false
    },
    {
      "name": "primes",
      "type": "worker",
      "x": 0,
      "y": 0,
      "width": 120,
      "height": 24,
      "props": {},
      "events": {
        "work": "primes_work",
        "progress": "primes_progress",
        "done": "primes_done"
      },
      "anchor": [
        "left",
        "top"
      ],
      "visible": true,
      "enabled": true,
      "locked": false
    },
    {
      "name": "notes",
      "type": "file_watcher",
      "x": 0,
      "y": 0,
      "width": 120,
      "height": 24,
      "props": {
        "path": ".",
        "pattern": "*.txt",
        "recursive": false,
        "interval": 500,
        "running": true
      },
      "events": {
        "change": "notes_change"
      },
      "anchor": [
        "left",
        "top"
      ],
      "visible": true,
      "enabled": true,
      "locked": false
    },
    {
      "name": "prefs",
      "type": "settings",
      "x": 0,
      "y": 0,
      "width": 120,
      "height": 24,
      "props": {
        "file": "",
        "remember": "command"
      },
      "events": {},
      "anchor": [
        "left",
        "top"
      ],
      "visible": true,
      "enabled": true,
      "locked": false
    },
    {
      "name": "toast",
      "type": "notification",
      "x": 0,
      "y": 0,
      "width": 120,
      "height": 24,
      "props": {
        "title": "Task runner",
        "text": ""
      },
      "events": {},
      "anchor": [
        "left",
        "top"
      ],
      "visible": true,
      "enabled": true,
      "locked": false
    }
  ]
}
